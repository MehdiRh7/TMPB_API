<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The NexusCore packages (Chat.*, Notifications.*, Nexus.*, NexusCore.*) are in ./packages,
       built from the Core repository with eng/pack-core-modules.ps1. -->
  <packageSources>
    <add key="NexusCore (local)" value="packages" />
  </packageSources>
</configuration>
